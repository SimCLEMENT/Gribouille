<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ColorPicker?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.GridPane?>

<AnchorPane prefWidth="90.0"
    xmlns="http://javafx.com/javafx/13"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="iut.gon.gribouille.controleurs.CouleursController"
    style="-fx-background-color: #d4d0c8;">
    <children>
        <ColorPicker fx:id="colorPicker" layoutX="5.0" layoutY="10.0" prefWidth="80.0" />
        <GridPane layoutX="5.0" layoutY="50.0" hgap="4.0" vgap="4.0">
            <children>
                <Button fx:id="btnRouge" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: red; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="0" GridPane.rowIndex="0" />
                <Button fx:id="btnVert" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: lime; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="1" GridPane.rowIndex="0" />
                <Button fx:id="btnBleu" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: blue; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="0" GridPane.rowIndex="1" />
                <Button fx:id="btnCyan" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: cyan; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Button fx:id="btnMagenta" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: magenta; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="0" GridPane.rowIndex="2" />
                <Button fx:id="btnJaune" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: yellow; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="1" GridPane.rowIndex="2" />
                <Button fx:id="btnNoir" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: black; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="0" GridPane.rowIndex="3" />
                <Button fx:id="btnBlanc" prefWidth="36.0" prefHeight="36.0"
                    style="-fx-background-color: white; -fx-border-color: #888; -fx-border-width: 1;"
                    GridPane.columnIndex="1" GridPane.rowIndex="3" />
            </children>
        </GridPane>
    </children>
</AnchorPane>