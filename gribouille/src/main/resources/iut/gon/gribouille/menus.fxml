<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.ToggleGroup?>

<MenuBar xmlns="http://javafx.com/javafx/13"
         xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="iut.gon.gribouille.controleurs.MenusController">
   <menus>
      <Menu mnemonicParsing="false" text="Dessin">
         <items>
            <MenuItem mnemonicParsing="false" text="Charger" onAction="#onCharger" />
            <MenuItem mnemonicParsing="false" text="Sauvegarder" onAction="#onSauvegarder" />
            <MenuItem mnemonicParsing="false" text="Exporter" />
            <SeparatorMenuItem />
            <MenuItem mnemonicParsing="false" text="Quitter" onAction="#onQuitte" />
         </items>
      </Menu>
      <Menu mnemonicParsing="false" text="Outils">
         <items>
            <Menu mnemonicParsing="false" text="Epaisseur">
               <items>
                  <RadioMenuItem mnemonicParsing="false" text="1">
                     <toggleGroup><ToggleGroup fx:id="groupeEpaisseur"/></toggleGroup>
                  </RadioMenuItem>
                  <RadioMenuItem mnemonicParsing="false" text="2" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" selected="true" text="3" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" text="4" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" text="5" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" text="6" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" text="7" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" text="8" toggleGroup="$groupeEpaisseur"/>
                  <RadioMenuItem mnemonicParsing="false" text="9" toggleGroup="$groupeEpaisseur"/>
               </items>
            </Menu>
            <RadioMenuItem fx:id="menuCrayon" mnemonicParsing="false" selected="true" text="Crayon">
               <toggleGroup><ToggleGroup fx:id="groupeOutil"/></toggleGroup>
            </RadioMenuItem>
            <RadioMenuItem fx:id="menuEtoile" mnemonicParsing="false" text="Etoile" toggleGroup="$groupeOutil"/>
         </items>
      </Menu>
      <Menu mnemonicParsing="false" text="Aide">
         <items>
            <MenuItem mnemonicParsing="false" text="A propos" />
         </items>
      </Menu>
   </menus>
</MenuBar>
